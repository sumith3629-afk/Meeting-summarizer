# ==============================================================================
# Environment Configuration for AI Meeting Assistant
# ==============================================================================

# Required: Mistral AI API key for transcript refinement and minutes generation
# Get your key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional: Mistral model name (default: open-mistral-7b)
# Options: open-mistral-7b, mistral-small-latest, mistral-large-latest
MISTRAL_MODEL=open-mistral-7b

# Optional: Faster-Whisper model size (default: small)
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL=small
